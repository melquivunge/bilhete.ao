APP_NAME=Bilhete.ao
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# A persistência é sempre em UTC: config/app.php fixa o fuso em UTC e não o lê do
# ambiente, de propósito. O fuso de apresentação (Africa/Luanda) é decidido no
# Marco 1 (B-023) e não pertence a esta configuração.
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL é a fonte de verdade da disponibilidade dos assentos.
# O host é o serviço do Docker Compose, criado em C0.3.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bilhete
DB_USERNAME=bilhete
# Deixado vazio de propósito. Nenhuma credencial funcional é versionada, nem
# sequer para desenvolvimento: o docker-compose.yml recusa arrancar sem este
# valor, em vez de cair para uma senha por omissão que seria herdada por
# qualquer ambiente que copiasse o ficheiro.
DB_PASSWORD=

# Sessões em PostgreSQL, não em Redis: Redis é cache, filas, rate limiting e
# locks auxiliares, nunca fonte de verdade (agent.md, secção 3).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Passam a redis em C0.7, quando Horizon e workers existirem.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Também vazio de propósito, pela mesma razão que DB_PASSWORD. O Redis do
# Compose arranca com requirepass e recusa ligações não autenticadas.
REDIS_PASSWORD=
REDIS_PORT=6379

# Nenhum envio real de mensagens é permitido (agent.md, secção 16).
# O driver "log" não é usado: escreveria tokens de recuperação em claro.
MAIL_MAILER=array
MAIL_FROM_ADDRESS="nao-responder@bilhete.ao"
MAIL_FROM_NAME="${APP_NAME}"

# Armazenamento compatível com S3 para cartazes. Sem credenciais reais aqui.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
